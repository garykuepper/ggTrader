# DRAFT: no Persistent catch-up and no randomized delay. Not approved for activation.
[Unit]
Description=ggTrader intraday observer recovery timer

[Timer]
OnCalendar=Mon..Fri *-*-* 15:15:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=ggtrader-intraday-observer-recover.service

[Install]
WantedBy=timers.target

# Claude Code: track the shared project assets (skills, hooks, project
# settings) so they survive a re-clone and are the same for everyone; keep
# machine-local overrides and scratch worktrees out.
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.bak
*.tmp
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
node_modules/
scratch/


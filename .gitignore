# --- Environment ---
.env

# --- ggTrader Data & Logs ---
logs/
data/raw/
data/parquet/
data/backups/
data/exports/
data/*.db*
data/*.csv
data/*.json
data/live/
!data/top_50_ccxt_volume.json

# Per-venue availability snapshots (Layer 1 registry) — keep tracked
!data/universe/
!data/universe/*_listings.json

# --- Research & Results (Selective Signal) ---
# Ignore all result directories and log/txt files by default
results/**/*

# BUT Always version-control the outcomes (Weights, Plots, Reports).
# NOTE: run_results.json is intentionally NOT whitelisted — these blobs are
# large (0.6-1.2MB each), regenerable, and don't diff usefully. Keep only the
# human-readable reports + small weight/stat summaries under version control.
!results/**/
!results/**/portfolio_weights.json
!results/**/phase_stats.json
!results/**/plots/
!results/**/plots/*.png
!results/**/final_report.md
!results/**/FINAL_WFO_RESEARCH_REPORT.md
!results/**/research_report.md
!results/research/*.md

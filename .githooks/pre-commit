#!/usr/bin/env bash
# Run the CI lint gate on staged Python files. The Claude ruff hook only sees
# Edit/Write, so files created via shell or cp slipped past it (f8e97b1).
# Enable once per clone: git config core.hooksPath .githooks
# ponytail: lints the working-tree copy, not the staged blob; fine unless you
# partially stage a file.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ ${#files[@]} -eq 0 ] && exit 0

ruff=.venv/bin/ruff
[ -x "$ruff" ] || ruff=ruff

"$ruff" check "${files[@]}" && "$ruff" format --check "${files[@]}" || {
    echo "pre-commit: ruff failed. Fix with: ruff check --fix <files> && ruff format <files>" >&2
    exit 1
}

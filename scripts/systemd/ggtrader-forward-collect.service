[Unit]
Wants=network-online.target
After=network-online.target
Description=ggTrader daily forward data collection

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h/ggTrader
TimeoutStartSec=1800
MemoryMax=1G
ExecStart=%h/ggTrader/.venv/bin/python %h/ggTrader/scripts/forward_collect.py
StandardOutput=journal
StandardError=journal

[Unit]
Wants=network-online.target
After=network-online.target
Description=ggTrader weekly forward shares observation

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h/ggTrader
TimeoutStartSec=14400
MemoryMax=1G
ExecStart=%h/ggTrader/.venv/bin/python %h/ggTrader/scripts/forward_collect.py --shares-only
StandardOutput=journal
StandardError=journal

# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit real keys.

# --- Alpaca (paper trading) ---
APCA_API_KEY_ID=your_alpaca_paper_key_id
APCA_API_SECRET_KEY=your_alpaca_paper_secret
APCA_API_LIVE_KEY_ID=your_alpaca_live_key_id
APCA_API_LIVE_SECRET_KEY=your_alpaca_live_secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# --- CoinMarketCap (symbol universe ranking) ---
CMC_API_KEY=your_coinmarketcap_api_key

# --- Binance ---
BINANCE_API_KEY=your_binance_paper_key
BINANCE_SECRET_KEY=your_binance_paper_secret
BINANCE_API_LIVE_KEY=your_binance_live_key
BINANCE_SECRET_LIVE_KEY=your_binance_live_secret

# --- Kraken (primary live exchange) ---
KRAKEN_KEY=your_kraken_api_key
KRAKEN_SECRET=your_kraken_api_secret

# --- TimescaleDB (local or remote PostgreSQL) ---
POSTGRES_CONNECTION_STRING=postgresql+psycopg2://user:password@host:port/dbname

# --- Notifications (daily PnL reports, alerts) ---
# Telegram: create a bot via @BotFather, then find your chat_id by sending the
# bot a message and visiting https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: server settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

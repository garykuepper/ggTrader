# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit real keys.
#
# Every key below is actually read by the code. Verified 2026-08-21 against
# every os.getenv/os.environ call in src/, scripts/, and ggt.py. If you add a
# key here, make sure something reads it; if you stop reading one, delete it.

# =============================================================================
# REQUIRED
# =============================================================================

# --- TimescaleDB / PostgreSQL ---
# Two ways to configure this; see src/ggTrader/utils/config.py:49-66.
#
# Priority 1 — the individual vars. If DB_USER, DB_PASS, DB_HOST and DB_NAME
# are ALL set they win outright and POSTGRES_CONNECTION_STRING is ignored.
# This is the usual Docker setup and a common source of "why is it hitting
# the wrong database".
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ggtrader
# DB_PASS=your_db_password
# DB_NAME=ggtrader
#
# Priority 2 — the full connection string. Simpler; prefer this unless you
# specifically need the split form.
# Note: if the host is `host.docker.internal` and that name does not resolve
# (i.e. you are on the host, not in a container), config.py rewrites it to
# `localhost` automatically.
POSTGRES_CONNECTION_STRING=postgresql+psycopg2://user:password@host:port/dbname

# Used only by the cached yfinance loader and scripts/mcp_server.py, which
# read a plain psycopg2 URL rather than going through utils/config.py.
# Same database — just the non-SQLAlchemy spelling (no `+psycopg2`).
GGTRADER_DB_URL=postgresql://user:password@host:port/dbname

# --- Alpaca (paper trading) ---
# The live trader is hardcoded to the PAPER endpoint
# (src/ggTrader/paper/alpaca_broker.py:28-34, `paper=True`). There is no
# live-trading key path, and no base-URL override is read.
APCA_API_KEY_ID=your_alpaca_paper_key_id
APCA_API_SECRET_KEY=your_alpaca_paper_secret

# =============================================================================
# OPTIONAL
# =============================================================================

# --- Telegram notifications (trade alerts, run failures) ---
# Create a bot via @BotFather, then find your chat_id by sending the bot a
# message and visiting https://api.telegram.org/bot<TOKEN>/getUpdates
# If unset, the notifier no-ops rather than failing the run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Grafana (dashboards at http://localhost:3002) ---
# Injected into grafana/provisioning/datasources/datasources.yaml so the DB
# credential is never committed. Both default to the local dev values, so a
# fresh clone works unset.
# GGTRADER_DB_USER=ggtrader
# GGTRADER_DB_PASSWORD=ggtrader
# GRAFANA_ADMIN_PASSWORD=admin

# --- Tiingo (equity OHLCV, fallback/alternative to yfinance) ---
# Free tier: 500 unique symbols/day, 20+ year history, covers delisted tickers.
# Sign up at https://www.tiingo.com
TIINGO_API_KEY=

# --- LiteLLM (headline_sentiment research strategy only) ---
# Only read by src/ggTrader/lab/headline_sentiment_data.py, which is a closed
# NO-GO strategy. Leave unset unless you are re-running that study.
LITELLM_MASTER_KEY=

# --- Exchange selection (crypto scripts only) ---
# Read by scripts/update_universe_ccxt.py and update_venue_listings.py. Both
# are currently BROKEN (they import a deleted module) and the crypto arc is
# parked, so this has no effect today.
# EXCHANGE=kraken

# --- Cash sweep (paper trading, default OFF) ---
# Feature-flagged idle-cash sweep (src/ggTrader/paper/cash_sweep.py): deploys
# cash left over after the day's strategy orders into a passive ETF, and
# sells that ETF back down first if the strategy's own buys need more cash
# than is on hand. NOT enabled anywhere -- leave unset/false until validated.
# CASH_SWEEP_ENABLED=false
# SWEEP_SYMBOL=SPY
# SWEEP_CASH_RESERVE_PCT=0.05
# SWEEP_MIN_CLIP_USD=500

# =============================================================================
# NOT USED — deliberately removed 2026-08-21
# =============================================================================
# These were listed here but nothing in the codebase reads them. They are
# recorded so nobody re-adds them assuming they were an oversight:
#
#   APCA_API_LIVE_KEY_ID, APCA_API_LIVE_SECRET_KEY, APCA_API_BASE_URL
#       — no live-trading path exists; the broker hardcodes paper=True.
#   CMC_API_KEY                — CoinMarketCap ranking was removed.
#   BINANCE_API_KEY, BINANCE_SECRET_KEY,
#   BINANCE_API_LIVE_KEY, BINANCE_SECRET_LIVE_KEY,
#   KRAKEN_KEY, KRAKEN_SECRET  — crypto execution is parked.
#   DISCORD_WEBHOOK_URL        — the notifier is Telegram-only
#                                (src/ggTrader/paper/notifier.py:19-20).
